#!/usr/bin/env bash
# Launch the local ssh-mcp-policy server for OpenChamber.
#
# The launcher refreshes a WSL-safe copy of the Windows OpenSSH config, installs
# the conservative policy example on first run, and starts the server from this
# checkout. It never copies private keys or identity files.
set -euo pipefail
umask 077

project=${SSH_MCP_POLICY_HOME:-}
windows_config=${SSH_MCP_WINDOWS_SSH_CONFIG:-}
alias_rewrites=${SSH_MCP_ALIAS_REWRITES:-}
ssh_dir="$HOME/.ssh"
hosts_config="$ssh_dir/windows-hosts.config"
policy_dir="$HOME/.config/ssh-mcp-policy"
policy_config="$policy_dir/policy.json"
state_dir="$HOME/.local/state/ssh-mcp-policy"

if [[ -z "$project" ]]; then
    echo "Set SSH_MCP_POLICY_HOME to the checkout path in WSL." >&2
    exit 1
fi
if [[ -z "$windows_config" ]]; then
    echo "Set SSH_MCP_WINDOWS_SSH_CONFIG to the Windows SSH config path in WSL." >&2
    exit 1
fi
if [[ ! -r "$windows_config" ]]; then
    echo "Windows SSH config is not readable: $windows_config" >&2
    exit 1
fi
if [[ ! -f "$project/src/ssh_mcp/__main__.py" ]]; then
    echo "ssh-mcp-policy source is missing: $project/src/ssh_mcp" >&2
    exit 1
fi
if ! python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 10))'; then
    echo "Python 3.10 or newer is required (found: $(python3 -V 2>&1))" >&2
    exit 1
fi

mkdir -p "$ssh_dir" "$policy_dir" "$state_dir"
hosts_tmp=$(mktemp "$ssh_dir/windows-hosts.config.XXXXXX")
config_tmp=""
cleanup() {
    rm -f "$hosts_tmp" "${config_tmp:-/nonexistent}"
}
trap cleanup EXIT

python3 - "$windows_config" "$alias_rewrites" > "$hosts_tmp" <<'PY'
import shlex
import sys

source = sys.argv[1]
rewrite_spec = sys.argv[2]
safe_directives = {
    "hostname": "HostName",
    "user": "User",
    "port": "Port",
    "proxyjump": "ProxyJump",
    "serveraliveinterval": "ServerAliveInterval",
    "serveralivecountmax": "ServerAliveCountMax",
}


def valid_alias(alias: str) -> bool:
    if not alias or alias.startswith("-"):
        return False
    if any(ch in alias for ch in "*?[]!"):
        return False
    if any(ch.isspace() for ch in alias):
        return False
    return True


alias_rewrites = {}
for entry in filter(None, (part.strip() for part in rewrite_spec.split(","))):
    if entry.count("=") != 1:
        raise SystemExit("SSH_MCP_ALIAS_REWRITES entries must use source=destination pairs")
    source_alias, destination_alias = entry.split("=", 1)
    if not valid_alias(source_alias) or not valid_alias(destination_alias):
        raise SystemExit("SSH_MCP_ALIAS_REWRITES contains an invalid host alias")
    alias_rewrites[source_alias] = destination_alias


def safe_alias(alias: str) -> str | None:
    if not valid_alias(alias):
        return None
    return alias_rewrites.get(alias, alias)


def map_jump(part: str) -> str:
    def map_one(jump: str) -> str:
        user, separator, alias = jump.rpartition("@")
        if separator and alias in alias_rewrites:
            return user + separator + alias_rewrites[alias]
        return alias_rewrites.get(jump, jump)

    return ",".join(map_one(jump) for jump in part.split(","))


blocks = []
current = None

with open(source, encoding="utf-8-sig", errors="replace") as handle:
    for raw in handle:
        try:
            fields = shlex.split(raw, comments=True, posix=True)
        except ValueError:
            continue
        if not fields:
            continue
        key = fields[0].lower()
        if key in {"host", "match"}:
            current = None
            if key != "host":
                continue
            aliases = [mapped for alias in fields[1:] if (mapped := safe_alias(alias))]
            if aliases:
                current = {"aliases": aliases, "options": []}
                blocks.append(current)
            continue
        if current is None or key not in safe_directives or len(fields) < 2:
            continue
        values = fields[1:]
        if any(
            not value or value.startswith("-") or any(ch.isspace() for ch in value)
            for value in values
        ):
            continue
        if key == "port" and (not values[0].isdigit() or not 1 <= int(values[0]) <= 65535):
            continue
        if key in {"serveraliveinterval", "serveralivecountmax"} and not values[0].isdigit():
            continue
        if key == "proxyjump":
            values = [
                ",".join(map_jump(part) for part in value.split(","))
                for value in values
            ]
        current["options"].append((safe_directives[key], values))

print("# Generated by ssh-mcp-policy-openchamber from the Windows OpenSSH config.")
print("# Only host aliases and safe connection directives are copied; keys are not.")
print()
for block in blocks:
    print("Host " + " ".join(block["aliases"]))
    for key, values in block["options"]:
        print("    " + key + " " + " ".join(values))
    print()
PY

chmod 600 "$hosts_tmp"
mv -f "$hosts_tmp" "$hosts_config"

ssh_config="$ssh_dir/config"
include_line="Include $hosts_config"
touch "$ssh_config"
if ! grep -Fqx "$include_line" "$ssh_config"; then
    config_tmp=$(mktemp "$ssh_dir/config.XXXXXX")
    {
        printf '%s\n\n' "$include_line"
        cat "$ssh_config"
    } > "$config_tmp"
    chmod 600 "$config_tmp"
    mv -f "$config_tmp" "$ssh_config"
fi
chmod 600 "$ssh_config"

if [[ ! -e "$policy_config" ]]; then
    cp "$project/config/policy.example.json" "$policy_config"
fi
chmod 600 "$policy_config"
if ! python3 -m json.tool "$policy_config" >/dev/null 2>&1; then
    echo "Policy config is not valid JSON: $policy_config" >&2
    exit 1
fi

export PYTHONPATH="$project/src${PYTHONPATH:+:$PYTHONPATH}"
export SSH_MCP_STATE_DIR="${SSH_MCP_STATE_DIR:-$state_dir}"
export SSH_MCP_POLICY_CONFIG="${SSH_MCP_POLICY_CONFIG:-$policy_config}"
exec python3 -m ssh_mcp
